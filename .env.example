ALPHA_VANTAGE_API_KEY=
# full supports historical ranges but requires a premium Alpha Vantage key.
# compact supports free keys and only the most recent 100 daily observations.
ALPHA_VANTAGE_OUTPUTSIZE=full

# Optional registry lease lifecycle. Use reachable base URLs.
REGISTRY_URLS=http://localhost:5000,http://localhost:5002
SERVICE_PUBLIC_URL=http://localhost:5005
# Leave unset for the current image: removal occurs after lease expiry.
# REGISTRY_REMOVE_PATH=/services/{service_id}
